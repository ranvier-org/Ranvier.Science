<Project Sdk="Microsoft.NET.Sdk">

    <!-- The sequential monitor in a native window: the shared sources in ../src, with Program.fs as the entry point. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../src/Host.fs" />
        <Compile Include="../src/App.fs" />
        <Compile Include="../src/Script.fs" />
        <Compile Include="Png.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ranvier" Version="0.2.0" />
        <PackageReference Include="Ranvier.View" Version="0.2.0" />
        <PackageReference Include="Ranvier.View.Dom" Version="0.2.0" />
        <PackageReference Include="Ranvier.View.WebCore.Sdl" Version="0.2.1" />
        <PackageReference Include="Ranvier.D5" Version="0.1.1" />
        <PackageReference Include="Ranvier.D5.View" Version="0.1.1" />
    </ItemGroup>

    <!-- Hot reload runs under the JIT only, so it is a Debug-only reference, used by "dotnet run" with the dev argument. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Ranvier.View.WebCore.Hmr" Version="0.1.3" />
    </ItemGroup>

</Project>
