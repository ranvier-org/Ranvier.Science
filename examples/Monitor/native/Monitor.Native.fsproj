<Project Sdk="Microsoft.NET.Sdk">

    <!-- The sequential monitor in a native window: the shared sources in ../src, with Program.fs as the entry point. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../src/Host.fs" />
        <Compile Include="../src/Plot.fs" />
        <Compile Include="../src/Charts.fs" />
        <Compile Include="../src/App.fs" />
        <Compile Include="../src/Script.fs" />
        <Compile Include="Png.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ranvier$(RanvierPackageSuffix)" Version="0.2.1" />
        <PackageReference Include="Ranvier.View$(RanvierPackageSuffix)" Version="0.4.0" />
        <PackageReference Include="Ranvier.View.Dom$(RanvierPackageSuffix)" Version="0.4.0" />
        <PackageReference Include="Ranvier.View.WebCore.Sdl$(RanvierPackageSuffix)" Version="0.2.3" />
        <PackageReference Include="Ranvier.D5$(RanvierPackageSuffix)" Version="0.5.1" />
        <PackageReference Include="Ranvier.D5.View$(RanvierPackageSuffix)" Version="0.5.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../model/Monitor.Model.fsproj" />
    </ItemGroup>

    <!-- Hot reload runs under the JIT only, so it is a Debug-only reference, used by "dotnet run" with the dev argument. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Ranvier.View.WebCore.Hmr$(RanvierPackageSuffix)" Version="0.1.5" />
    </ItemGroup>

</Project>
