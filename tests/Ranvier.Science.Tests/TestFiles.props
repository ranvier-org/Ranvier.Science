<Project>
    <!-- The suite, in compile order. Ranvier.Science.Tests and Ranvier.Science.Tests.Fable both compile it. -->
    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)Exact.fs" Link="Exact.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)Support.fs" Link="Support.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)Smoke.fs" Link="Smoke.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)Probes.fs" Link="Probes.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)SumTests.fs" Link="SumTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)MomentsTests.fs" Link="MomentsTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)AggregateTests.fs" Link="AggregateTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)ToleranceTests.fs" Link="ToleranceTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)UnitsTests.fs" Link="UnitsTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)QuantityTests.fs" Link="QuantityTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)FormulaTests.fs" Link="FormulaTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)OpenOrderTests.fs" Link="OpenOrderTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)GeneratorTests.fs" Link="GeneratorTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)RunTests.fs" Link="RunTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)ConfidenceSequenceTests.fs" Link="ConfidenceSequenceTests.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)Recorded.fs" Link="Recorded.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)CrossTargetTests.fs" Link="CrossTargetTests.fs" />
    </ItemGroup>
</Project>
