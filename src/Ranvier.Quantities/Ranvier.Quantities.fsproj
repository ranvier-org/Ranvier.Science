<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Units, quantities and models on the Ranvier reactive graph, with a one-line formula notation over a model's quantities and runs: simulations advanced with a clock.</Description>
        <PackageTags>units;units-of-measure;quantities;formula;simulation;ranvier;reactive;fsharp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Units.fs" />
        <Compile Include="Model.fs" />
        <Compile Include="Formula.fs" />
        <Compile Include="Quantity.fs" />
        <Compile Include="Run.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ranvier.Numerics\Ranvier.Numerics.fsproj" />
    </ItemGroup>

</Project>
