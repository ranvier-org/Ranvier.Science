<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Statistics over the moments of Ranvier.Numerics: the normal quantile, a time-uniform confidence sequence for a mean and the fixed-sample interval.</Description>
        <PackageTags>statistics;normal-quantile;confidence-sequence;confidence-interval;ranvier;fsharp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="NormalQuantile.fs" />
        <Compile Include="Check.fs" />
        <Compile Include="ConfidenceSequence.fs" />
        <Compile Include="Continuous.fs" />
        <Compile Include="Discrete.fs" />
        <Compile Include="Describe.fs" />
        <Compile Include="Intervals.fs" />
        <Compile Include="HypothesisTest.fs" />
        <Compile Include="Sequential.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ranvier.Numerics\Ranvier.Numerics.fsproj" />
    </ItemGroup>

</Project>
