<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Numerics for the Ranvier reactive graph: compensated sums, moments, float policies and maintained aggregates, tolerances and a pseudo-random generator.</Description>
        <PackageTags>numerics;compensated-summation;moments;aggregates;floating-point;ranvier;reactive;fsharp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Sum.fs" />
        <Compile Include="Moments.fs" />
        <Compile Include="FloatPolicy.fs" />
        <Compile Include="Aggregate.fs" />
        <Compile Include="Tolerance.fs" />
        <Compile Include="Generator.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ranvier" Version="0.2.0" />
    </ItemGroup>

</Project>
