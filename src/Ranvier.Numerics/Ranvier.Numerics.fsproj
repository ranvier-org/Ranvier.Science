<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Numerics for the Ranvier reactive graph: special functions, root finding, minimisation and least squares, quadrature, ODE integration, interpolation, dense linear algebra, the Fourier transform, compensated sums, moments, streaming and windowed accumulators, maintained aggregates, tolerances and random variates.</Description>
        <PackageTags>numerics;special-functions;linear-algebra;least-squares;root-finding;quadrature;ode;interpolation;fft;moments;aggregates;random;ranvier;reactive;fsharp</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Doubles.fs" />
        <Compile Include="Sum.fs" />
        <Compile Include="Moments.fs" />
        <Compile Include="Special.fs" />
        <Compile Include="LinearAlgebra.fs" />
        <Compile Include="Roots.fs" />
        <Compile Include="LeastSquares.fs" />
        <Compile Include="Calculus.fs" />
        <Compile Include="Ode.fs" />
        <Compile Include="Interpolate.fs" />
        <Compile Include="Fourier.fs" />
        <Compile Include="Comoments.fs" />
        <Compile Include="HigherMoments.fs" />
        <Compile Include="WeightedMoments.fs" />
        <Compile Include="Windows.fs" />
        <Compile Include="OrderStatistic.fs" />
        <Compile Include="Histogram.fs" />
        <Compile Include="FloatPolicy.fs" />
        <Compile Include="Aggregate.fs" />
        <Compile Include="Tolerance.fs" />
        <Compile Include="Generator.fs" />
        <Compile Include="Uncertain.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Ranvier" Version="0.2.1" />
    </ItemGroup>

</Project>
