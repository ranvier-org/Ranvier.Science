<Project>
    <Import Project="../Directory.Build.props" />

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>$(MSBuildProjectName)$(RanvierPackageSuffix)</PackageId>
        <Version>0.2.1</Version>
        <!-- The minimum FSharp.Core of the packages, the one Ranvier 0.2.1 depends on. -->
        <FSharpCoreImplicitPackageVersion>8.0.100</FSharpCoreImplicitPackageVersion>
        <FablePackageType>library</FablePackageType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>0.2.1: adds .Traced package twins (Ranvier.Numerics.Traced, Ranvier.Quantities.Traced, Ranvier.Statistics.Traced) built with RANVIER_TRACE on Ranvier.Traced 0.2.1. Numerics: special functions, roots, minimisation and least squares, quadrature and differentiation, ODE integration, interpolation, dense linear algebra, the Fourier transform, streaming and windowed accumulators, random variates. Quantities: an SI unit catalogue with prefixes, parsing and conversion, CODATA 2022 physical constants, first-order and Monte Carlo propagation of uncertainty, formula entries, runs with an ODE integrator. Statistics: distributions, descriptive statistics, intervals, hypothesis tests, a sequential test, multiple-testing adjustments, regression, correlation, curve fitting, the bootstrap and density estimation. Built on Ranvier 0.2.1. The interfaces will change before 1.0.</PackageReleaseNotes>
        <!-- Fable.Package.SDK sets DebugType=embedded: the PDB (with SourceLink) lives in each dll, so no .snupkg is produced. nuget.org rejects an empty one. -->
        <IncludeSymbols>false</IncludeSymbols>
    </PropertyGroup>

    <!-- A CI build maps source paths to /_/. -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- A traced build's creation sites skip frames from an assembly with this marker. -->
    <ItemGroup>
        <AssemblyMetadata Include="RanvierLibrary" Value="true" />
        <AssemblyMetadata Condition="'$(RanvierTrace)' == 'true'" Include="RanvierTrace" Value="true" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
        <PackageReference Include="Fable.Package.SDK" Version="1.4.1" PrivateAssets="all"
                          IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />
    </ItemGroup>
</Project>
